run = "npm run start"
entrypoint = "src/app/page.tsx"
modules = ["nodejs-22"]

[nix]
channel = "stable-24_05"

# IMPORTANT: Set all secrets via Replit Secrets panel (padlock icon)
# MONGODB_URI, JWT_SECRET, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET
# DO NOT hardcode credentials in this file
[env]
NODE_OPTIONS = "--max-old-space-size=4096"

[languages.typescript]
pattern = "**/*.ts"

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 3002
externalPort = 3002
